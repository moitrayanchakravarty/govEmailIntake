# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Replace with your actual local or MongoDB Atlas connection URI string
MONGO_URI=mongodb://localhost:27017/email-portal

# Security & Authentication (Required by Better Auth)
# Generate a high-entropy 32-character secret string to encrypt session tokens
BETTER_AUTH_SECRET=your_32_character_high_entropy_secret_string

# Better-Auth URLs
# The absolute base URL of your API server where authentication endpoints are hosted
BETTER_AUTH_URL=http://localhost:5000

# Client Configuration
# The frontend URL allowed to cross-origin resource share (CORS) credentials
CLIENT_URL=http://localhost:5173
